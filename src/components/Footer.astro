---
import { site } from '../data/site';
const ano = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <span>© {ano} {site.nome}</span>
    <nav aria-label="Redes">
      {site.links.linkedin && <a href={site.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>}
      {site.links.youtube && <a href={site.links.youtube} target="_blank" rel="noopener">YouTube</a>}
      {site.links.whatsapp && <a href={site.links.whatsapp} target="_blank" rel="noopener">WhatsApp</a>}
      {site.links.email && <a href={`mailto:${site.links.email}`}>E-mail</a>}
    </nav>
  </div>
</footer>
