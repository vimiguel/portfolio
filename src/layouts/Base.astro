---
// Estrutura comum a todas as páginas: <head>, header e footer.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  titulo?: string;
  descricao?: string;
}

const { titulo, descricao = site.descricao } = Astro.props;
const tituloCompleto = titulo ? `${titulo} · ${site.nome}` : `${site.nome} · ${site.cargo}`;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    <meta
      name="keywords"
      content="Product Manager, Gerente de Produto, PMO, Product Strategy, Roadmap, Priorização, RICE, Discovery, Stakeholder Management, IA generativa, Go-to-Market, Agile"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:image" content={new URL('/images/refinamento.jpg', Astro.site)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@100..125,400..900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
