---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CaseCard from '../components/CaseCard.astro';
import CTA from '../components/CTA.astro';
import { site, tiposProjeto, competencias, metodo, conteudo } from '../data/site';

// Cases marcados com "destaque: true", na ordem definida no arquivo
const destaques = (await getCollection('cases', ({ data }) => data.destaque))
  .sort((a, b) => a.data.ordem - b.data.ordem);
---

<Base>
  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <span class="kicker">{site.hero.kicker}</span>
      <h1>{site.hero.titulo} <em>{site.hero.destaque}</em></h1>
      <div class="hero-rodape">
        <p>{site.hero.texto}</p>
        <div class="acoes">
          <a href="/cases" class="botao botao--primario">Ver cases →</a>
          {site.links.agenda && <a href={site.links.agenda} class="botao botao--contorno" target="_blank" rel="noopener">Agendar conversa</a>}
        </div>
      </div>
    </div>
  </section>

  <!-- TIPOS DE PROJETO -->
  <section class="container tipos" aria-labelledby="tipos-titulo">
    <h2 id="tipos-titulo" class="kicker">Tipos de projeto que já liderei</h2>
    <ol class="tipos-grade">
      {tiposProjeto.map((t) => (
        <li class="tipo">
          <h3>{t.titulo}</h3>
          <p>{t.texto}</p>
          <ul class="tipo-cases">
            {t.cases.map((c) => (
              <li><a href={`/cases/${c.slug}`}>{c.nome} →</a></li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </section>

  <!-- CASES EM DESTAQUE -->
  <section class="secao">
    <div class="container">
      <div class="secao-topo">
        <div>
          <span class="kicker">Cases selecionados</span>
          <h2 class="titulo-secao">O que eu entreguei</h2>
        </div>
        <a href="/cases" class="link-seta">Ver todos os cases →</a>
      </div>
      <div class="grade-cases">
        {destaques.map((item) => <CaseCard item={item} />)}
      </div>
    </div>
  </section>

  <!-- COMPETÊNCIAS -->
  <section class="secao secao--alt">
    <div class="container">
      <span class="kicker">Competências</span>
      <h2 class="titulo-secao">O que eu levo pro time</h2>
      <p class="lead" style="margin-bottom: 48px">
        As habilidades que as vagas de produto mais pedem hoje, cada uma com um resultado que comprova.
      </p>
      <div class="competencias">
        {competencias.map((c) => (
          <article class="competencia">
            <h3>{c.titulo}</h3>
            <ul class="keywords" aria-label="Palavras-chave">
              {c.keywords.map((k) => <li>{k}</li>)}
            </ul>
            <p>{c.texto}</p>
            <a href={c.prova.href} class="prova">
              <strong>{c.prova.valor}</strong>
              <span>{c.prova.rotulo} →</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- COMO EU TRABALHO -->
  <section class="secao">
    <div class="container">
      <span class="kicker">Como eu trabalho</span>
      <h2 class="titulo-secao">Refinamento antes da execução</h2>
      <p class="lead" style="margin-bottom: 48px">
        Projeto que trava quase nunca é problema técnico. Costuma ser falta de clareza, uma decisão que ninguém tomou ou responsabilidade mal definida. Meu trabalho é resolver isso primeiro.
      </p>
      <div class="metodo">
        {metodo.map((m) => (
          <div class="passo">
            <h3>{m.titulo}</h3>
            <p>{m.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTEÚDO / YOUTUBE -->
  <section class="secao secao--alt">
    <div class="container conteudo">
      <div>
        <span class="kicker">Conteúdo</span>
        <h2 class="titulo-secao">{conteudo.titulo}</h2>
        <p class="lead">{conteudo.texto}</p>
        {site.links.youtube && (
          <a href={site.links.youtube} class="botao botao--primario" style="margin-top: 20px" target="_blank" rel="noopener">
            Assistir no YouTube →
          </a>
        )}
      </div>
      <img src={conteudo.imagem} alt="Vinícius Miguel lendo um caderno, com o título Refinamento" loading="lazy" />
    </div>
  </section>

  <CTA />
</Base>
