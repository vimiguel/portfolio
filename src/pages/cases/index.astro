---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CaseCard from '../../components/CaseCard.astro';

const cases = (await getCollection('cases')).sort((a, b) => a.data.ordem - b.data.ordem);
const empresas = [...new Set(cases.map((c) => c.data.empresa))];
---

<Base titulo="Cases" descricao="Projetos que liderei em produto, operações e governança.">
  <section class="case-topo">
    <div class="container">
      <span class="kicker">Portfólio</span>
      <h1 class="titulo-secao" style="font-size: clamp(2.6rem, 8vw, 6rem)">Cases</h1>
      <p class="lead">
        {cases.length} projetos, de operações nacionais com 420+ franquias a jornadas de compra com IA no WhatsApp.
      </p>
    </div>
  </section>

  <section class="container" style="padding-bottom: 96px">
    <div class="filtros" role="group" aria-label="Filtrar por empresa">
      <button class="filtro" data-filtro="todos" aria-pressed="true">Todos</button>
      {empresas.map((e) => <button class="filtro" data-filtro={e} aria-pressed="false">{e}</button>)}
    </div>
    <div class="grade-cases grade-cases--3" id="lista">
      {cases.map((item) => <CaseCard item={item} />)}
    </div>
  </section>
</Base>

<script>
  // Filtro simples por empresa
  const botoes = document.querySelectorAll<HTMLButtonElement>('.filtro');
  const cards = document.querySelectorAll<HTMLElement>('#lista .card');

  botoes.forEach((botao) => {
    botao.addEventListener('click', () => {
      const alvo = botao.dataset.filtro;
      botoes.forEach((b) => b.setAttribute('aria-pressed', String(b === botao)));
      cards.forEach((card) => {
        const mostra = alvo === 'todos' || card.dataset.empresa === alvo;
        card.style.display = mostra ? '' : 'none';
      });
    });
  });
</script>
