---
// Página de cada case. Gerada a partir dos arquivos em src/content/cases.
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';

export async function getStaticPaths() {
  const cases = (await getCollection('cases')).sort((a, b) => a.data.ordem - b.data.ordem);
  return cases.map((item, i) => ({
    params: { slug: item.id },
    props: { item, proximo: cases[(i + 1) % cases.length] },
  }));
}

const { item, proximo } = Astro.props;
const { titulo, empresa, periodo, papel, resumo, logo, tags, metricas, materiais } = item.data;
const { Content } = await render(item);
---

<Base titulo={titulo} descricao={resumo}>
  <section class="case-topo">
    <div class="container">
      <a href="/cases" class="voltar">← Todos os cases</a>
      <span class="kicker" style="display: block">{empresa}</span>
      <h1>{titulo}</h1>
      <p class="lead">{resumo}</p>
      <dl class="case-meta">
        <div><dt>Empresa</dt><dd>{empresa}</dd></div>
        <div><dt>Meu papel</dt><dd>{papel}</dd></div>
        {periodo && <div><dt>Período</dt><dd>{periodo}</dd></div>}
      </dl>
    </div>
  </section>

  <div class="container">
    {metricas.length > 0 && (
      <div class="case-metricas">
        {metricas.map((m) => (
          <div>
            <strong>{m.valor}</strong>
            <span>{m.rotulo}</span>
          </div>
        ))}
      </div>
    )}

    <div class="case-corpo">
      <article class="prosa">
        <Content />
      </article>

      <aside class="lateral">
        {logo && (
          <div class="box">
            <img src={logo} alt={empresa} />
          </div>
        )}
        {tags.length > 0 && (
          <div class="box">
            <h3>Competências</h3>
            <ul class="tags">
              {tags.map((t) => <li class="tag">{t}</li>)}
            </ul>
          </div>
        )}
        {materiais.length > 0 && (
          <div class="box">
            <h3>Materiais</h3>
            <ul>
              {materiais.map((m) => (
                <li>{m.url ? <a href={m.url} target="_blank" rel="noopener">{m.titulo} ↗</a> : m.titulo}</li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>

    <nav class="proximo" aria-label="Próximo case">
      <a href="/cases"><small>Voltar</small><strong>← Todos os cases</strong></a>
      <a href={`/cases/${proximo.id}`} style="text-align: right">
        <small>Próximo case</small>
        <strong>{proximo.data.titulo} →</strong>
      </a>
    </nav>
  </div>

  <CTA />
</Base>
